# ═══════════════════════════════════════════════════════════════ #
#  skhdrc — yabai hotkeys (Hyprland-inspired)
# ═══════════════════════════════════════════════════════════════ #

# ─── Window Focus ───────────────────────────────────────────────

# direction focus (Hyprland: jkl;)
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# ─── Window Movement ───────────────────────────────────────────

# move window in direction (Hyprland: SUPER+SHIFT+jkl;)
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# warp window to direction (swap and move cursor)
shift + alt - left  : yabai -m window --warp west
shift + alt - down  : yabai -m window --warp south
shift + alt - up    : yabai -m window --warp north
shift + alt - right : yabai -m window --warp east

# ─── Window Resize ─────────────────────────────────────────────

# expand window in direction
shift + alt - a : yabai -m window --resize left:-20:0
shift + alt - s : yabai -m window --resize bottom:0:20
shift + alt - w : yabai -m window --resize top:0:-20
shift + alt - d : yabai -m window --resize right:20:0

# balance all windows
shift + alt - 0 : yabai -m space --balance

# ─── Window Toggle ─────────────────────────────────────────────

# zoom / maximize
alt - m : yabai -m window --toggle zoom-parent
alt - f : yabai -m window --toggle zoom-fullscreen

# float / center
alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# toggle split (auto vs manual)
alt - e : yabai -m window --toggle split

# sticky + pip
alt - p : yabai -m window --toggle sticky --toggle pip

# ─── Insertion Point ────────────────────────────────────────────

# set where new windows will land
ctrl + alt - h : yabai -m window --insert west
ctrl + alt - j : yabai -m window --insert south
ctrl + alt - k : yabai -m window --insert north
ctrl + alt - l : yabai -m window --insert east

# ─── Workspaces ─────────────────────────────────────────────────

# create / delete
shift + cmd - n : yabai -m space --create && \
                  index="$(yabai -m query --spaces --display | jq 'map(select(."is-native-fullscreen" == false)) | .[-1].index')" && \
                  yabai -m window --space "${index}" && \
                  yabai -m space --focus "${index}"
shift + cmd - w : yabai -m space --destroy

# focus workspace (Hyprland: SUPER+1-9)
cmd + alt - x : yabai -m space --focus recent
cmd + alt - 1 : yabai -m space --focus 1
cmd + alt - 2 : yabai -m space --focus 2
cmd + alt - 3 : yabai -m space --focus 3
cmd + alt - 4 : yabai -m space --focus 4
cmd + alt - 5 : yabai -m space --focus 5
cmd + alt - 6 : yabai -m space --focus 6
cmd + alt - 7 : yabai -m space --focus 7
cmd + alt - 8 : yabai -m space --focus 8
cmd + alt - 9 : yabai -m space --focus 9

# send focused window to workspace and follow
shift + cmd + alt - x : yabai -m window --space recent; yabai -m space --focus recent
shift + cmd + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + cmd + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + cmd + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + cmd + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + cmd + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + cmd + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6
shift + cmd + alt - 7 : yabai -m window --space 7; yabai -m space --focus 7
shift + cmd + alt - 8 : yabai -m window --space 8; yabai -m space --focus 8
shift + cmd + alt - 9 : yabai -m window --space 9; yabai -m space --focus 9

# ─── Monitors ───────────────────────────────────────────────────

# focus monitor
ctrl + alt - z : yabai -m display --focus prev
ctrl + alt - 3 : yabai -m display --focus 3

# send window to monitor and follow
ctrl + cmd + alt - c : yabai -m window --display next; yabai -m display --focus next
ctrl + cmd + alt - 1 : yabai -m window --display 1; yabai -m display --focus 1

# ─── Floating Window Fine Control ───────────────────────────────

# nudge floating window
shift + ctrl - a : yabai -m window --move rel:-20:0
shift + ctrl - s : yabai -m window --move rel:0:20
shift + ctrl - w : yabai -m window --move rel:0:-20
shift + ctrl - d : yabai -m window --move rel:20:0

# ─── Reload / Restart ───────────────────────────────────────────

# restart yabai (no sudo needed for nonservice installs)
cmd + alt + ctrl - r : launchctl kickstart -k "gui/${UID}/homebrew.mxcl.yabai"
